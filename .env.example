# Generate a secret key with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change_me_to_a_long_random_secret

# Set to true only for local development; defaults to false for safety
DEBUG=false

USE_POSTGRES=true
POSTGRES_DB=bytehub
POSTGRES_USER=bytehub_user
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60

# Docker: Load seed data from dev_seed.json on startup (set to false for production)
LOAD_FIXTURE_DATA=true

STRIPE_PUBLIC_KEY=pk_test_prueba
STRIPE_SECRET_KEY=sk_test_prueba
# el webhook secret se actualiza cada vez que se ponga a escuchar el puerto, toca descargar stripe cli
STRIPE_WEBHOOK_SECRET=whsec_prueba